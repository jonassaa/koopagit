[HKEY_CLASSES_ROOT\Drive\shellex\ContextMenuHandlers\koopagit]
@="{5e1a8f00-6b4c-4d1f-9a2e-7c0d3b1e4a00}"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved]
"{5e1a8f00-6b4c-4d1f-9a2e-7c0d3b1e4a00}"="KoopaGit context menu"

; Overlay handlers, in priority order (Conflict ... Unversioned). The leading
; spaces sort them early; Explorer only loads the first 15 handlers overall.

