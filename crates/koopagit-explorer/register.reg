Windows Registry Editor Version 5.00

; KoopaGit Explorer extension. Replace the DLL path if installed elsewhere.
; Requires admin (HKLM). Restart Explorer afterwards. Unverified template.

[HKEY_CLASSES_ROOT\CLSID\{5e1a8f00-6b4c-4d1f-9a2e-7c0d3b1e4a00}]
@="KoopaGit context menu"

[HKEY_CLASSES_ROOT\CLSID\{5e1a8f00-6b4c-4d1f-9a2e-7c0d3b1e4a00}\InprocServer32]
@="C:\\Program Files\\KoopaGit\\koopagit_explorer.dll"
"ThreadingModel"="Apartment"

[HKEY_CLASSES_ROOT\*\shellex\ContextMenuHandlers\koopagit]
@="{5e1a8f00-6b4c-4d1f-9a2e-7c0d3b1e4a00}"

[HKEY_CLASSES_ROOT\Directory\shellex\ContextMenuHandlers\koopagit]
@="{5e1a8f00-6b4c-4d1f-9a2e-7c0d3b1e4a00}"

[HKEY_CLASSES_ROOT\Directory\Background\shellex\ContextMenuHandlers\koopagit]
