// CSubmoduleAddDlg (IDD_SUBMODULE_ADD, "Submodule Add") and
// CRequestPullDlg (IDD_REQUESTPULL, "Request pull").
import { Button, CheckBox, LineEdit, GroupBox, VerticalBox, HorizontalBox, TextEdit } from "std-widgets.slint";
import { EditCombo } from "remote_widgets.slint";
import { NoticeBar } from "msgbox.slint";
import { KoopaWindow } from "window.slint";
import { DialogKeys } from "keys.slint";

export component SubmoduleAddDialog inherits KoopaWindow {
    in property <string> dialog-title: "Submodule Add - KoopaGit";
    in property <string> project;
    in-out property <string> repository;
    in property <[string]> repository-history;
    in-out property <string> path;
    in property <[string]> path-history;
    in-out property <bool> use-branch;
    in-out property <string> branch;
    in-out property <bool> force;
    in property <string> notice-text;
    callback repository-edited();
    callback browse-repository();
    callback browse-path();
    callback ok();
    callback cancel();

    title: root.dialog-title;
    preferred-width: 540px;
    min-width: 440px;

    forward-focus: keys;
    keys := DialogKeys {
        ok => { root.ok(); }
        cancel => { root.cancel(); }
        // IDD_SUBMODULE_ADD: &Force. "Load Putty &Key" has no KoopaGit counterpart.
        access-key(k) => {
            if (k == "f") { root.force = !root.force; force-check.focus(); return true; }
            false
        }
        VerticalBox {
            GroupBox {
                title: "Submodule of Project: " + root.project;
                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Repository:"; vertical-alignment: center; width: 80px; }
                        EditCombo {
                            text <=> root.repository;
                            items: root.repository-history;
                            edited => { root.repository-edited(); }
                            selected => { root.repository-edited(); }
                            accepted => { root.ok(); }
                        }
                        Button { text: "..."; width: 36px; clicked => { root.browse-repository(); } }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Path:"; vertical-alignment: center; width: 80px; }
                        EditCombo { text <=> root.path; items: root.path-history; accepted => { root.ok(); } }
                        Button { text: "..."; width: 36px; clicked => { root.browse-path(); } }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                CheckBox { text: "Branch"; checked <=> root.use-branch; }
                if root.use-branch: LineEdit {
                    text <=> root.branch;
                    accepted => { root.ok(); }
                }
            }
            force-check := CheckBox { text: "Force"; checked <=> root.force; }
            NoticeBar { text: root.notice-text; error: true; }
            HorizontalBox {
                padding: 0;
                alignment: end;
                Button { text: "OK"; primary: true; clicked => { root.ok(); } }
                Button { text: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}

export component RequestPullDialog inherits KoopaWindow {
    in property <string> dialog-title: "Request pull - KoopaGit";
    in-out property <string> start;
    in property <[string]> start-items;
    in-out property <string> url;
    in property <[string]> url-history;
    in-out property <string> end-rev;
    in-out property <bool> send-mail;
    in property <string> notice-text;
    callback ok();
    callback cancel();

    title: root.dialog-title;
    preferred-width: 560px;
    min-width: 440px;

    // IDD_REQUESTPULL's "&Start" and "Repository &URL" labels would focus the
    // EditCombos, which cannot take focus from outside (no forward-focus).
    forward-focus: keys;
    keys := DialogKeys {
        ok => { root.ok(); }
        cancel => { root.cancel(); }
        VerticalBox {
            HorizontalLayout {
                spacing: 6px;
                Text { text: "Start"; vertical-alignment: center; width: 110px; }
                EditCombo { text <=> root.start; items: root.start-items; accepted => { root.ok(); } }
            }
            HorizontalLayout {
                spacing: 6px;
                Text { text: "Repository URL"; vertical-alignment: center; width: 110px; }
                EditCombo { text <=> root.url; items: root.url-history; accepted => { root.ok(); } }
            }
            HorizontalLayout {
                spacing: 6px;
                Text { text: "End"; vertical-alignment: center; width: 110px; }
                LineEdit {
                    text <=> root.end-rev;
                    accepted => { root.ok(); }
                }
            }
            CheckBox { text: "Send Mail after create"; checked <=> root.send-mail; }
            NoticeBar { text: root.notice-text; error: true; }
            HorizontalBox {
                padding: 0;
                alignment: end;
                Button { text: "OK"; primary: true; clicked => { root.ok(); } }
                Button { text: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}

// The generated pull request (upstream opens it in the alternative editor).
export component TextResultDialog inherits KoopaWindow {
    in property <string> dialog-title;
    in property <string> text;
    in property <string> status;
    callback copy();
    callback save();
    callback close-dialog();

    title: root.dialog-title;
    preferred-width: 680px;
    preferred-height: 480px;
    min-width: 420px;
    min-height: 260px;

    // Close is the default button; Escape closes too.
    forward-focus: keys;
    keys := DialogKeys {
        ok => { root.close-dialog(); }
        cancel => { root.close-dialog(); }
        VerticalBox {
            TextEdit { text: root.text; read-only: true; wrap: no-wrap; font-size: 12px; vertical-stretch: 1; }
            HorizontalBox {
                padding: 0;
                Text { text: root.status; vertical-alignment: center; color: #888; horizontal-stretch: 1; }
                Button { text: "Copy"; clicked => { root.copy(); } }
                Button { text: "Save..."; clicked => { root.save(); } }
                Button { text: "Close"; primary: true; clicked => { root.close-dialog(); } }
            }
        }
    }
}
