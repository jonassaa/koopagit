// CLogDlg (IDD_LOGMESSAGE): caption "Log Messages".
import { Button, CheckBox, ComboBox, LineEdit, TextEdit, ListView, ScrollView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";
import { FileList, FileRow, Colors } from "common.slint";
import { NoticeBar } from "msgbox.slint";
import { DynMenuArea, MenuBlock } from "dynmenu.slint";
import { KoopaWindow } from "window.slint";
import { DialogKeys } from "keys.slint";

export struct RefChip {
    name: string,
    // 0 current branch, 1 local branch, 2 remote branch, 3 tag, 4 stash, 5 other
    kind: int,
}

// The lines of one graph row drawn in one lane colour: SVG path commands in
// px (lane width 16, row height 22) and the index into the lane colours.
export struct GraphPath {
    commands: string,
    color: int,
}

export struct LogRow {
    graph: [GraphPath],
    lanes: int,
    node: int,
    // Merge commits get a square node, others a round one.
    merge: bool,
    refs: [RefChip],
    message: string,
    author: string,
    date: string,
    sha: string,
    is-head: bool,
    selected: bool,
    // The "Working tree changes" pseudo-row.
    wc: bool,
}

component Chip inherits Rectangle {
    in property <RefChip> chip;
    height: 16px;
    width: label.preferred-width + 8px;
    border-radius: 3px;
    border-width: chip.kind == 0 ? 2px : 1px;
    border-color: #0006;
    background: chip.kind == 0 || chip.kind == 1 ? #ff8c42 : chip.kind == 2 ? #f0e442
        : chip.kind == 3 ? #fcdc3c : chip.kind == 4 ? #b0b0b0 : #c8c8ff;
    label := Text {
        text: chip.name;
        color: black;
        font-size: 11px;
        font-weight: chip.kind == 0 ? 700 : 400;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component HeaderCell inherits Text {
    font-weight: 600;
    vertical-alignment: center;
    overflow: elide;
}

component Cell inherits Text {
    vertical-alignment: center;
    overflow: elide;
}

component Popup inherits Rectangle {
    background: Palette.background;
    border-width: 1px;
    border-color: #888;
}

export component LogDialog inherits KoopaWindow {
    in property <string> dialog-title: "Log Messages - KoopaGit";
    in property <string> ref-label: "Branch";
    in-out property <string> filter-text;
    in-out property <bool> filter-subject: true;
    in-out property <bool> filter-messages: true;
    in-out property <bool> filter-paths;
    in-out property <bool> filter-authors: true;
    in-out property <bool> filter-emails;
    in-out property <bool> filter-sha: true;
    in-out property <bool> filter-refs: true;
    in-out property <bool> filter-notes;
    in-out property <bool> filter-regex;
    in-out property <bool> filter-case;
    in property <bool> filter-error;
    in property <[LogRow]> rows;
    in-out property <int> current-row: -1;
    in property <string> details;
    in property <[FileRow]> files;
    in property <string> info-text;
    in-out property <bool> whole-project;
    in property <bool> whole-project-enabled: true;
    in-out property <bool> all-branches;
    in-out property <bool> first-parent;
    in-out property <bool> no-merges;
    in-out property <bool> show-sha;
    in-out property <bool> show-tags: true;
    in-out property <bool> show-local-branches: true;
    in-out property <bool> show-remote-branches: true;
    in-out property <bool> show-other-refs: true;
    in-out property <string> date-from;
    in-out property <string> date-to;
    in-out property <string> jump-text;
    in-out property <int> jump-type;
    in property <[string]> jump-types;
    in property <bool> loading;
    in property <string> branch;
    in property <string> notice-text;
    in property <[string]> notice-buttons;
    in property <bool> notice-error;
    in property <string> copy-text;
    // Branch line colours (Colors\BranchLine1..8) and their dark-mode variants.
    in property <[color]> lane-colors: [#000000, #ff0000, #00ff00, #0000ff, #808080, #808000, #008080, #800080];
    in property <[color]> lane-colors-dark: [#ffffff, #ff0000, #00ff00, #0000ff, #7f7f7f, #ffff7f, #7fffff, #ff7fff];
    in property <length> graph-line-width: 2px;
    in property <length> graph-node-size: 10px;
    in property <length> graph-width: 64px;

    callback refresh();
    callback filter-changed();
    callback labels-changed();
    // Left click with modifiers: (row, toggle (Ctrl/Cmd), range (Shift)).
    callback row-pressed(int, bool, bool);
    callback row-activated(int);
    callback key-move(int, bool);
    callback select-all();
    // Context menus: content from Rust, evaluated each time a menu opens.
    pure callback row-menu(int) -> [MenuBlock];
    callback menu-action(int, int);
    pure callback ref-menu() -> [MenuBlock];
    callback ref-menu-action(int);
    callback browse-refs();
    pure callback from-menu() -> [MenuBlock];
    callback from-menu-action(int);
    pure callback message-menu(bool) -> [MenuBlock];
    callback message-menu-action(int);
    callback file-activated(int);
    callback jump(bool);
    callback statistics();
    callback notice-clicked(int);
    callback ok();
    callback cancel();
    // ID_EDIT_COPY (Ctrl+C, Ctrl+Insert): the selected commits in full.
    callback copy-selection();
    // Ctrl+V, Shift+Insert: jump to the commit hash on the clipboard.
    callback paste-hash();

    public function focus-filter() {
        filter-edit.focus();
    }

    title: root.dialog-title;
    preferred-width: 1020px;
    preferred-height: 760px;
    min-width: 680px;
    min-height: 500px;
    forward-focus: log-list;

    property <length> lane-width: 16px;
    property <length> row-height: 22px;

    pure function lane-color(i: int) -> color {
        return Palette.color-scheme == ColorScheme.dark ? root.lane-colors-dark[i] : root.lane-colors[i];
    }

    keys := DialogKeys {
        // Enter does not close the Log: OnOK only acts when the OK button has focus.
        ok-enabled: false;
        // ID_EXITCLEARFILTER: Escape clears an active filter first, then closes.
        cancel => {
            if (root.filter-text != "") {
                root.filter-text = "";
                root.filter-changed();
            } else {
                root.cancel();
            }
        }
        // IDD_LOGMESSAGE captions, plus the Alt+D and Alt+Up/Down accelerators.
        access-key(k) => {
            if (k == "w" && root.whole-project-enabled) {
                root.whole-project = !root.whole-project;
                whole-project-check.focus();
                root.refresh();
                return true;
            }
            if (k == "a") {
                root.all-branches = !root.all-branches;
                all-branches-check.focus();
                root.refresh();
                return true;
            }
            if (k == "t" && !root.loading && root.rows.length > 0) { root.statistics(); return true; }
            if (k == "h") { walk-popup.show(); return true; }
            if (k == "v") { view-popup.show(); return true; }
            if (k == "d") { filter-edit.focus(); return true; }
            if (k == Key.UpArrow) { root.jump(true); return true; }
            if (k == Key.DownArrow) { root.jump(false); return true; }
            false
        }
        // IDR_ACC_LOGDLG. Without a Find dialog, Ctrl+F and F3 focus the filter.
        KeyBinding { keys: @keys(F5); activated => { root.refresh(); } }
        KeyBinding { keys: @keys(Control + F5); activated => { root.refresh(); } }
        KeyBinding { keys: @keys(Shift + F5); activated => { root.refresh(); } }
        KeyBinding { keys: @keys(Control + F); activated => { filter-edit.focus(); } }
        KeyBinding { keys: @keys(F3); activated => { filter-edit.focus(); } }
        KeyBinding { keys: @keys(Control + L); activated => { filter-edit.focus(); } }
        KeyBinding {
            keys: @keys(Control + E);
            activated => {
                filter-edit.focus();
                filter-edit.select-all();
            }
        }
        KeyBinding { keys: @keys(Alt + UpArrow); activated => { root.jump(true); } }
        KeyBinding { keys: @keys(Alt + DownArrow); activated => { root.jump(false); } }
        KeyBinding { keys: @keys(Control + C); activated => { root.copy-selection(); } }
        KeyBinding { keys: @keys(Control + Insert); activated => { root.copy-selection(); } }
        KeyBinding { keys: @keys(Control + V); activated => { root.paste-hash(); } }
        KeyBinding { keys: @keys(Shift + Insert); activated => { root.paste-hash(); } }
        VerticalBox {
            HorizontalBox {
                padding: 0;
                ref-menu-area := DynMenuArea {
                    blocks() => { return root.ref-menu(); }
                    chosen(id) => { root.ref-menu-action(id); }
                    ref-text := Text {
                        text: root.ref-label;
                        vertical-alignment: center;
                        font-weight: 600;
                        color: #0366d6;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.browse-refs(); }
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                    ref-menu-area.show({ x: self.mouse-x, y: self.mouse-y });
                                }
                            }
                        }
                    }
                }
                Text { text: "From:"; vertical-alignment: center; }
                DynMenuArea {
                    width: 110px;
                    blocks() => { return root.from-menu(); }
                    chosen(id) => { root.from-menu-action(id); }
                    LineEdit {
                        width: 110px;
                        text <=> root.date-from;
                        placeholder-text: "YYYY-MM-DD";
                        accepted => { root.refresh(); }
                    }
                }
                Text { text: "To:"; vertical-alignment: center; }
                LineEdit {
                    width: 110px;
                    text <=> root.date-to;
                    placeholder-text: "YYYY-MM-DD";
                    accepted => { root.refresh(); }
                }
                Rectangle { horizontal-stretch: 1; }
                filter-edit := LineEdit {
                    width: 300px;
                    text <=> root.filter-text;
                    placeholder-text: "Filter by "
                        + (root.filter-subject ? "Subject, " : "")
                        + (root.filter-messages ? "Messages, " : "")
                        + (root.filter-paths ? "Paths, " : "")
                        + (root.filter-authors ? "Authors, " : "")
                        + (root.filter-emails ? "Emails, " : "")
                        + (root.filter-sha ? "SHA-1, " : "")
                        + (root.filter-refs ? "Refname, " : "")
                        + (root.filter-notes ? "Notes" : "");
                    edited => { root.filter-changed(); }
                    accepted => { root.filter-changed(); }
                }
                Button { text: "▾"; width: 28px; clicked => { filter-popup.show(); } }
            }
            HorizontalBox {
                padding: 0;
                Text { text: "Jump:"; vertical-alignment: center; }
                LineEdit {
                    width: 180px;
                    text <=> root.jump-text;
                    placeholder-text: "text";
                    accepted => { root.jump(false); }
                }
                ComboBox {
                    width: 170px;
                    model: root.jump-types;
                    current-index <=> root.jump-type;
                }
                Button { text: "▲"; width: 32px; clicked => { root.jump(true); } }
                Button { text: "▼"; width: 32px; clicked => { root.jump(false); } }
                Rectangle { horizontal-stretch: 1; }
            }
            // Revision list
            Rectangle {
                vertical-stretch: 3;
                border-width: 1px;
                border-color: #8886;
                // The log list's own keys (CGitLogListBase); a row click focuses it.
                log-list := FocusScope {
                    key-pressed(e) => {
                        if (e.modifiers.alt) { return reject; }
                        if (e.text == Key.UpArrow) { root.key-move(-1, e.modifiers.shift); return accept; }
                        if (e.text == Key.DownArrow) { root.key-move(1, e.modifiers.shift); return accept; }
                        if (e.text == Key.Home) { root.key-move(-root.rows.length, e.modifiers.shift); return accept; }
                        if (e.text == Key.End) { root.key-move(root.rows.length, e.modifiers.shift); return accept; }
                        if ((e.modifiers.control || e.modifiers.meta) && (e.text == "a" || e.text == "A")) {
                            root.select-all();
                            return accept;
                        }
                        // Diffs only with DiffByDoubleClickInLog (checked in Rust); never closes.
                        if (e.text == Key.Return && !e.modifiers.control) {
                            if (root.current-row >= 0) { root.row-activated(root.current-row); }
                            return accept;
                        }
                        reject
                    }
                }
                VerticalLayout {
                    Rectangle {
                        height: 22px;
                        background: Colors.header-bg;
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 6px;
                            HeaderCell { text: "Graph"; width: root.graph-width; }
                            if root.show-sha: HeaderCell { text: "SHA-1"; width: 80px; }
                            HeaderCell { text: "Message"; horizontal-stretch: 1; }
                            HeaderCell { text: "Author"; width: 140px; }
                            HeaderCell { text: "Date"; width: 130px; }
                        }
                    }
                    ListView {
                        for row[i] in root.rows: Rectangle {
                            height: root.row-height;
                            background: row.selected ? Colors.selection : transparent;
                            border-width: i == root.current-row ? 1px : 0px;
                            border-color: #0366d688;
                            DynMenuArea {
                                blocks() => { return root.row-menu(i); }
                                chosen(id) => { root.menu-action(i, id); }
                                TouchArea {
                                    double-clicked => { root.row-activated(i); }
                                    pointer-event(e) => {
                                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                            log-list.focus();
                                            root.row-pressed(i, e.modifiers.control || e.modifiers.meta, e.modifiers.shift);
                                        }
                                        if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                            parent.show({ x: self.mouse-x, y: self.mouse-y });
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 6px;
                                spacing: 6px;
                                Rectangle {
                                    width: root.graph-width;
                                    clip: true;
                                    // Path insets its viewbox by half the stroke on every
                                    // side; grow it by the stroke so lines meet the row edges.
                                    for p in row.graph: Path {
                                        x: -root.graph-line-width / 2;
                                        y: -root.graph-line-width / 2;
                                        width: max(1, row.lanes) * root.lane-width + root.graph-line-width;
                                        height: root.row-height + root.graph-line-width;
                                        viewbox-x: 0;
                                        viewbox-y: 0;
                                        viewbox-width: max(1, row.lanes) * 16;
                                        viewbox-height: 22;
                                        commands: p.commands;
                                        stroke: root.lane-color(p.color);
                                        stroke-width: root.graph-line-width;
                                    }
                                    Rectangle {
                                        x: row.node * root.lane-width + (root.lane-width - self.width) / 2;
                                        y: (root.row-height - self.height) / 2;
                                        width: row.wc ? 8px : root.graph-node-size;
                                        height: self.width;
                                        border-radius: row.wc || row.merge ? 0px : self.width / 2;
                                        background: row.wc ? #d73a49 : root.lane-color(mod(row.node, 8));
                                    }
                                }
                                if root.show-sha: Cell { text: row.sha; width: 80px; font-family: "monospace"; }
                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    alignment: start;
                                    for chip in row.refs: VerticalLayout {
                                        alignment: center;
                                        Chip { chip: chip; }
                                    }
                                    Cell {
                                        text: row.message;
                                        font-weight: row.is-head ? 700 : 400;
                                        font-italic: row.wc;
                                    }
                                }
                                Cell { text: row.author; width: 140px; }
                                Cell { text: row.date; width: 130px; }
                            }
                        }
                    }
                }
            }
            // Message pane: selectable text with Copy / Copy all / Edit Notes.
            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: #8886;
                DynMenuArea {
                    blocks() => {
                        return root.message-menu(msg-input.anchor-position-byte-offset != msg-input.cursor-position-byte-offset);
                    }
                    chosen(id) => {
                        if (id == 1) {
                            msg-input.copy();
                        } else {
                            root.message-menu-action(id);
                        }
                    }
                    ScrollView {
                        content-height: max(self.visible-height, msg-input.preferred-height + 8px);
                        content-width: self.visible-width;
                        msg-input := TextInput {
                            x: 6px;
                            y: 4px;
                            width: parent.visible-width - 12px;
                            text: root.details;
                            read-only: true;
                            single-line: false;
                            wrap: word-wrap;
                            color: Palette.foreground;
                        }
                    }
                }
            }
            FileList {
                vertical-stretch: 1;
                rows: root.files;
                checkable: false;
                list-id: 1;
                menu-enabled: true;
                activated(i) => { root.file-activated(i); }
            }
            if root.copy-text != "": HorizontalBox {
                padding: 0;
                Text { text: "Copy:"; vertical-alignment: center; }
                LineEdit { text: root.copy-text; read-only: true; }
            }
            NoticeBar {
                text: root.notice-text;
                buttons: root.notice-buttons;
                error: root.notice-error;
                clicked(i) => { root.notice-clicked(i); }
            }
            Text {
                text: root.loading ? "Loading..." : root.info-text;
                color: root.filter-error ? Colors.conflict : Colors.muted;
            }
            HorizontalBox {
                padding: 0;
                whole-project-check := CheckBox {
                    text: "Show Whole Project";
                    enabled: root.whole-project-enabled;
                    checked <=> root.whole-project;
                    toggled => { root.refresh(); }
                }
                all-branches-check := CheckBox {
                    text: "All Branches";
                    checked <=> root.all-branches;
                    toggled => { root.refresh(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Refresh"; clicked => { root.refresh(); } }
                Button { text: "Statistics"; enabled: !root.loading && root.rows.length > 0; clicked => { root.statistics(); } }
                Button {
                    text: "Walk Behavior";
                    primary: root.first-parent || root.no-merges;
                    clicked => { walk-popup.show(); }
                }
                Button { text: "View"; clicked => { view-popup.show(); } }
                Button { text: "OK"; clicked => { root.ok(); } }
            }
        }
    }

    filter-popup := PopupWindow {
        x: root.width - 240px;
        y: 44px;
        close-policy: close-on-click-outside;
        Popup {
            VerticalBox {
                CheckBox { text: "Subject"; checked <=> root.filter-subject; toggled => { root.filter-changed(); } }
                CheckBox { text: "Messages"; checked <=> root.filter-messages; toggled => { root.filter-changed(); } }
                CheckBox { text: "Paths"; checked <=> root.filter-paths; toggled => { root.filter-changed(); } }
                CheckBox { text: "Authors"; checked <=> root.filter-authors; toggled => { root.filter-changed(); } }
                CheckBox { text: "Emails"; checked <=> root.filter-emails; toggled => { root.filter-changed(); } }
                CheckBox { text: "SHA-1"; checked <=> root.filter-sha; toggled => { root.filter-changed(); } }
                CheckBox { text: "Refname"; checked <=> root.filter-refs; toggled => { root.filter-changed(); } }
                CheckBox { text: "Notes"; checked <=> root.filter-notes; toggled => { root.filter-changed(); } }
                Rectangle { height: 1px; background: #8886; }
                CheckBox { text: "Use regular expression"; checked <=> root.filter-regex; toggled => { root.filter-changed(); } }
                CheckBox { text: "Case-sensitive"; checked <=> root.filter-case; toggled => { root.filter-changed(); } }
            }
        }
    }
    walk-popup := PopupWindow {
        x: root.width - 400px;
        y: root.height - 120px;
        close-policy: close-on-click-outside;
        Popup {
            VerticalBox {
                CheckBox { text: "First Parent"; checked <=> root.first-parent; toggled => { root.refresh(); } }
                CheckBox { text: "No merges"; checked <=> root.no-merges; toggled => { root.refresh(); } }
            }
        }
    }
    view-popup := PopupWindow {
        x: root.width - 240px;
        y: root.height - 210px;
        close-policy: close-on-click-outside;
        Popup {
            VerticalBox {
                CheckBox { text: "Show SHA-1 column"; checked <=> root.show-sha; }
                Text { text: "Labels"; font-weight: 600; }
                CheckBox { text: "Tags"; checked <=> root.show-tags; toggled => { root.labels-changed(); } }
                CheckBox { text: "Local branches"; checked <=> root.show-local-branches; toggled => { root.labels-changed(); } }
                CheckBox { text: "Remote branches"; checked <=> root.show-remote-branches; toggled => { root.labels-changed(); } }
                CheckBox { text: "Other refs"; checked <=> root.show-other-refs; toggled => { root.labels-changed(); } }
            }
        }
    }
}

export struct StatRow {
    label: string,
    value: string,
}

// CStatGraphDlg: "Statistics" page (tables only).
export component StatisticsDialog inherits KoopaWindow {
    in property <string> dialog-title: "Statistics";
    in property <[StatRow]> summary;
    in property <[StatRow]> per-author;
    in property <[StatRow]> per-week;
    callback dismiss();
    title: root.dialog-title;
    preferred-width: 620px;
    preferred-height: 520px;
    forward-focus: keys;
    // No buttons: Enter (IDOK) and Escape (IDCANCEL) both close it.
    keys := DialogKeys {
        ok => { root.dismiss(); }
        cancel => { root.dismiss(); }
    }
    VerticalBox {
        for s in root.summary: HorizontalLayout {
            spacing: 8px;
            Text { text: s.label; width: 240px; }
            Text { text: s.value; font-weight: 600; }
        }
        HorizontalBox {
            padding: 0;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 4px;
                Text { text: "Commits by author"; font-weight: 600; }
                ListView {
                    for s in root.per-author: HorizontalLayout {
                        height: 20px;
                        spacing: 8px;
                        Text { text: s.label; horizontal-stretch: 1; overflow: elide; }
                        Text { text: s.value; width: 60px; horizontal-alignment: right; }
                    }
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text { text: "Commits by week"; font-weight: 600; }
                ListView {
                    for s in root.per-week: HorizontalLayout {
                        height: 20px;
                        spacing: 8px;
                        Text { text: s.label; horizontal-stretch: 1; }
                        Text { text: s.value; width: 60px; horizontal-alignment: right; }
                    }
                }
            }
        }
    }
}

// Edit Notes (`git notes`), multi-line.
export component NotesDialog inherits KoopaWindow {
    in property <string> dialog-title: "Edit Notes";
    in-out property <string> text;
    in property <string> error;
    callback ok();
    callback cancel();
    title: root.dialog-title;
    preferred-width: 520px;
    preferred-height: 300px;
    forward-focus: edit;
    keys := DialogKeys {
        ok => { root.ok(); }
        cancel => { root.cancel(); }
        // CInputDlg: Ctrl+Enter is OK; plain Enter is a newline in the editor.
        KeyBinding { keys: @keys(Control + Return); activated => { root.ok(); } }
        VerticalBox {
            edit := TextEdit { text <=> root.text; vertical-stretch: 1; wrap: word-wrap; }
            NoticeBar { text: root.error; error: true; }
            HorizontalBox {
                padding: 0;
                alignment: end;
                Button { text: "OK"; primary: true; clicked => { root.ok(); } }
                Button { text: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}
