// Shared widgets: the GitStatusListCtrl-like file list.
import { CheckBox, ListView, Palette } from "std-widgets.slint";
import { MenuBlock, DynMenuArea } from "dynmenu.slint";
import { SpaceActivate } from "keys.slint";
import { Theme } from "theme.slint";

export struct FileRow {
    checked: bool,
    // Part of the multi-row selection (`selection.rs`).
    selected: bool,
    path: string,
    extension: string,
    status: string,
    added: string,
    removed: string,
    // Colour class: 0 normal, 1 added, 2 deleted/missing, 3 modified, 4 conflict, 5 renamed, 6 unversioned
    kind: int,
}

// Status colours used across dialogs; values come from the active theme.
export global Colors {
    out property <color> added: Theme.added;
    out property <color> deleted: Theme.deleted;
    out property <color> modified: Theme.modified;
    out property <color> conflict: Theme.conflict;
    out property <color> renamed: Theme.renamed;
    out property <color> muted: Theme.muted;
    out property <brush> header-bg: Theme.header-bg;
    out property <color> selection: Theme.selection;
    out property <color> diff-add: Theme.diff-add;
    out property <color> diff-del: Theme.diff-del;
    out property <color> diff-hunk: Theme.diff-hunk;
}

// Routes every FileList's mouse, keyboard and context-menu events to Rust
// (`filelist_actions::FileListMenu::install`); `list` is the FileList's `list-id`.
export global FileListBridge {
    callback pressed(int, int, bool, bool);
    callback right-pressed(int, int, bool);
    pure callback menu(int, int) -> [MenuBlock];
    callback chosen(int, int, int);
    // key codes: 0 up, 1 down, 2 select all, 3 home, 4 end; returns the new current row
    callback key(int, int, bool) -> int;
    // Enter: runs the dialog's activation on every selected row; false = not
    // handled, and the list activates its current row itself.
    callback activate(int) -> bool;
    // Space: toggles the current row's check mark, and every selected row's with it.
    callback space(int);
    // Ctrl+C / Ctrl+Insert (true = with Shift: path and status columns).
    callback copy(int, bool);
    // Delete (true = Shift+Delete, permanent).
    callback delete(int, bool);
}

component Cell inherits Text {
    vertical-alignment: center;
    overflow: elide;
}

// Column header band of a list: a grey band in Classic, a hairline in the modern theme.
export component ListHeader inherits Rectangle {
    height: Theme.header-height;
    background: Theme.header-bg;
    @children
    if Theme.modern: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

export component HeaderText inherits Text {
    font-weight: Theme.header-weight;
    color: Theme.header-fg;
    vertical-alignment: center;
    overflow: elide;
}

// Selection/hover fill behind a list row: full width in Classic, inset and
// rounded in the modern theme. `current` draws the focus outline.
export component RowBackground {
    in property <bool> selected;
    in property <bool> hover;
    in property <bool> current;
    // Background of a row that is marked but not selected.
    in property <color> fill: transparent;
    Rectangle {
        x: Theme.row-inset;
        width: root.width - 2 * Theme.row-inset;
        height: root.height;
        border-radius: Theme.row-radius;
        background: root.selected ? Theme.selection : root.hover ? Theme.hover : root.fill;
        border-width: root.current ? 1px : 0px;
        border-color: Theme.focus-ring;
    }
}

// A bordered list/tree container: plain box in Classic, rounded card in the modern theme.
export component Panel inherits Rectangle {
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.panel-radius;
    background: Theme.surface;
    clip: Theme.modern;
}

// Background of a hand-drawn popup menu or options panel.
export component PopupPanel inherits Rectangle {
    background: Theme.popup-bg;
    border-width: 1px;
    border-color: Theme.border-strong;
    border-radius: Theme.modern ? 8px : 0px;
}

// CLinkControl: a hyperlink-style label that is a Tab stop. Space, Enter or a
// click activates it; `clicked(shift)` reports whether Shift was held.
export component LinkLabel {
    in property <string> text;
    in property <bool> active: true;
    callback clicked(bool);
    public function take-focus() { focus.focus(); }
    property <bool> shift;
    min-width: label.preferred-width;
    preferred-width: label.preferred-width;
    min-height: label.preferred-height;
    preferred-height: label.preferred-height;
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(e) => {
            root.shift = e.modifiers.shift;
            reject
        }
        key-pressed(e) => {
            if (e.text == Key.Return && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta) {
                if (root.active) { root.clicked(root.shift); }
                return accept;
            }
            reject
        }
        label := Text {
            text: root.text;
            vertical-alignment: center;
            color: root.active ? Theme.link : Theme.disabled;
        }
        focus := SpaceActivate {
            enabled: root.active;
            activated => { root.clicked(root.shift); }
        }
        TouchArea {
            enabled: root.active;
            mouse-cursor: pointer;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) { root.shift = e.modifiers.shift; }
            }
            clicked => {
                focus.focus();
                root.clicked(root.shift);
            }
        }
    }
}

export component FileList inherits Rectangle {
    in-out property <[FileRow]> rows;
    in property <bool> checkable: true;
    in property <bool> show-numstat: true;
    in property <bool> enabled: true;
    // Identifies this list in FileListBridge; enables the context menu when set up.
    in property <int> list-id: 0;
    in property <bool> menu-enabled: false;
    // Column captions (FileDiffDlg uses "File" / "Action").
    in property <string> path-header: "Path";
    in property <string> status-header: "Status";
    in-out property <int> current: -1;
    callback toggled(int, bool);
    callback activated(int);
    callback context(int);

    forward-focus: keys;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.panel-radius;
    background: Theme.surface;
    clip: Theme.modern;
    VerticalLayout {
        ListHeader {
            HorizontalLayout {
                padding-left: (root.checkable ? 30px : 6px) + Theme.row-inset;
                padding-right: Theme.row-inset;
                spacing: 6px;
                HeaderText { text: root.path-header; horizontal-stretch: 6; }
                HeaderText { text: "Extension"; width: 70px; }
                HeaderText { text: root.status-header; width: 90px; }
                if root.show-numstat: HeaderText { text: "Lines added"; width: 80px; horizontal-alignment: Theme.modern ? right : left; }
                if root.show-numstat: HeaderText { text: "Lines removed"; width: 90px; horizontal-alignment: Theme.modern ? right : left; }
            }
        }
        // GitStatusListCtrl keys (spec-keyboard §1.1). Escape and Tab bubble to the dialog.
        keys := FocusScope {
            key-pressed(e) => {
                if (e.modifiers.alt) { return reject; }
                if (e.text == Key.UpArrow) { root.current = FileListBridge.key(root.list-id, 0, e.modifiers.shift); return accept; }
                if (e.text == Key.DownArrow) { root.current = FileListBridge.key(root.list-id, 1, e.modifiers.shift); return accept; }
                if (e.text == Key.Home) { root.current = FileListBridge.key(root.list-id, 3, e.modifiers.shift); return accept; }
                if (e.text == Key.End) { root.current = FileListBridge.key(root.list-id, 4, e.modifiers.shift); return accept; }
                if (e.modifiers.control || e.modifiers.meta) {
                    if (e.text.to-lowercase() == "a") {
                        FileListBridge.key(root.list-id, 2, false);
                        return accept;
                    }
                    if (e.text.to-lowercase() == "c" || e.text == Key.Insert) {
                        FileListBridge.copy(root.list-id, e.modifiers.shift);
                        return accept;
                    }
                    // Ctrl+Enter belongs to the dialog (OK in Commit, Add, Revert, Resolve).
                    return reject;
                }
                if (e.text == Key.Return) {
                    if (!FileListBridge.activate(root.list-id) && root.current >= 0) { root.activated(root.current); }
                    return accept;
                }
                if (e.text == " " && root.checkable) {
                    if (root.enabled) { FileListBridge.space(root.list-id); }
                    return accept;
                }
                if (e.text == Key.Delete) {
                    FileListBridge.delete(root.list-id, e.modifiers.shift);
                    return accept;
                }
                reject
            }
            ListView {
                for row[i] in root.rows: Rectangle {
                    height: Theme.row-height;
                    RowBackground {
                        width: parent.width;
                        height: parent.height;
                        selected: row.selected || i == root.current;
                        hover: row-touch.has-hover;
                    }
                    DynMenuArea {
                        enabled: root.menu-enabled;
                        blocks() => { return FileListBridge.menu(root.list-id, i); }
                        chosen(id) => { FileListBridge.chosen(root.list-id, i, id); }
                        row-touch := TouchArea {
                            double-clicked => { root.current = i; root.activated(i); }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    keys.focus();
                                    root.current = i;
                                    if (e.button == PointerEventButton.left) {
                                        FileListBridge.pressed(root.list-id, i, e.modifiers.control || e.modifiers.meta, e.modifiers.shift);
                                    }
                                    if (e.button == PointerEventButton.right) {
                                        FileListBridge.right-pressed(root.list-id, i, e.modifiers.shift);
                                        root.context(i);
                                        if (root.menu-enabled) {
                                            parent.show({ x: self.mouse-x, y: self.mouse-y });
                                        }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 6px + Theme.row-inset;
                        padding-right: Theme.row-inset;
                        spacing: 6px;
                        if root.checkable: CheckBox {
                            width: 20px;
                            enabled: root.enabled;
                            checked <=> row.checked;
                            toggled => { root.toggled(i, self.checked); }
                        }
                        Cell {
                            text: row.path;
                            horizontal-stretch: 6;
                            color: row.kind == 1 ? Colors.added : row.kind == 2 ? Colors.deleted
                                : row.kind == 3 ? Colors.modified : row.kind == 4 ? Colors.conflict
                                : row.kind == 5 ? Colors.renamed : row.kind == 6 ? Colors.muted : Palette.foreground;
                        }
                        Cell { text: row.extension; width: 70px; color: Theme.modern ? Theme.muted : Palette.foreground; }
                        Cell { text: row.status; width: 90px; }
                        if root.show-numstat: Cell { text: row.added; width: 80px; horizontal-alignment: right; color: Theme.plus; }
                        if root.show-numstat: Cell { text: row.removed; width: 90px; horizontal-alignment: right; color: Theme.minus; }
                    }
                }
            }
        }
    }
}
