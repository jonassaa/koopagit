// Dialogs of the less common commands: git-svn, Send Mail, References commit
// is on, First Start Wizard.
import { Button, CheckBox, ComboBox, GroupBox, LineEdit, ListView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";
import { Radio } from "choose.slint";
import { NoticeBar } from "msgbox.slint";
import { DynMenuArea, MenuBlock } from "dynmenu.slint";
import { KoopaWindow } from "window.slint";
import { DialogKeys, SpaceActivate } from "keys.slint";
import { Theme } from "theme.slint";

// IDD_SVNDCOMMITTYPE: caption "SVN Commit Type".
export component SvnDcommitDialog inherits KoopaWindow {
    in property <string> dialog-title: "SVN Commit Type";
    in-out property <bool> rmdir;
    in-out property <bool> remember;
    callback ok();
    callback cancel();
    title: root.dialog-title;
    min-width: 380px;
    forward-focus: keys;
    keys := DialogKeys {
        ok => { root.ok(); }
        cancel => { root.cancel(); }
        // IDD_SVNDCOMMITTYPE: Normal &SVN Commit, &Git Style Commit (--rmdir).
        access-key(k) => {
            if (k == "s") { root.rmdir = false; svn-radio.take-focus(); return true; }
            if (k == "g") { root.rmdir = true; git-radio.take-focus(); return true; }
            false
        }
        VerticalBox {
            GroupBox {
                title: "DCommit Type";
                VerticalLayout {
                    spacing: 4px;
                    svn-radio := Radio { text: "Normal SVN Commit"; checked: !root.rmdir; clicked => { root.rmdir = false; } }
                    git-radio := Radio { text: "Git Style Commit (--rmdir)"; checked: root.rmdir; clicked => { root.rmdir = true; } }
                }
            }
            CheckBox { text: "Remember selection (\"svn.rmdir\" option)"; checked <=> root.remember; }
            HorizontalBox {
                padding: 0;
                alignment: end;
                Button { text: "OK"; primary: true; clicked => { root.ok(); } }
                Button { text: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}

// IDD_SVNIGNORE: caption "Import SVN Ignore".
export component SvnIgnoreDialog inherits KoopaWindow {
    in property <string> dialog-title: "Import SVN Ignore";
    // 0 .git/info/exclude, 1 .gitignore
    in-out property <int> ignore-type;
    callback ok();
    callback cancel();
    title: root.dialog-title;
    min-width: 460px;
    // IDD_SVNIGNORE has no access keys.
    forward-focus: keys;
    keys := DialogKeys {
        ok => { root.ok(); }
        cancel => { root.cancel(); }
        VerticalBox {
            GroupBox {
                title: "Type";
                VerticalLayout {
                    spacing: 4px;
                    Radio {
                        text: "Import svn ignore file to .git/info/exclude file (file will be overwritten)";
                        checked: root.ignore-type == 0;
                        clicked => { root.ignore-type = 0; }
                    }
                    Radio {
                        text: "Create .gitignore file";
                        checked: root.ignore-type == 1;
                        clicked => { root.ignore-type = 1; }
                    }
                }
            }
            HorizontalBox {
                padding: 0;
                alignment: end;
                Button { text: "OK"; primary: true; clicked => { root.ok(); } }
                Button { text: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}

export struct MailPatchRow {
    checked: bool,
    path: string,
}

// IDD_SENDMAIL: caption "Send Patch".
export component SendMailDialog inherits KoopaWindow {
    in property <string> dialog-title: "Send Patch";
    in-out property <string> to;
    in-out property <string> cc;
    in-out property <string> subject;
    in-out property <bool> attachment;
    in-out property <bool> combine;
    in-out property <[MailPatchRow]> patches;
    in property <string> delivery-note;
    in property <string> notice-text;
    callback combine-toggled();
    callback patch-toggled(int, bool);
    callback patch-activated(int);
    callback email-settings();
    callback send();
    callback cancel();
    title: root.dialog-title;
    preferred-width: 640px;
    preferred-height: 440px;
    min-width: 480px;
    // IDD_SENDMAIL has no access keys; "Send" is the default button.
    forward-focus: keys;
    keys := DialogKeys {
        ok => { root.send(); }
        cancel => { root.cancel(); }
        VerticalBox {
            GroupBox {
                title: "Mail";
                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "To:"; width: 70px; vertical-alignment: center; }
                        LineEdit {
                            text <=> root.to;
                            placeholder-text: "address; address";
                            accepted => { root.send(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "CC:"; width: 70px; vertical-alignment: center; }
                        LineEdit {
                            text <=> root.cc;
                            accepted => { root.send(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Subject:"; width: 70px; vertical-alignment: center; }
                        LineEdit {
                            text <=> root.subject;
                            enabled: root.combine;
                            accepted => { root.send(); }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                CheckBox { text: "Patch As Attachment"; checked <=> root.attachment; }
                CheckBox {
                    text: "Combine One Mail";
                    checked <=> root.combine;
                    toggled => { root.combine-toggled(); }
                }
                Rectangle { horizontal-stretch: 1; }
                // The "eMail settings" link is a tab stop (WS_TABSTOP).
                Text {
                    text: "eMail settings";
                    color: Theme.link;
                    vertical-alignment: center;
                    settings-link := SpaceActivate {
                        activated => { root.email-settings(); }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            settings-link.focus();
                            root.email-settings();
                        }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: Palette.border;
                ListView {
                    for p[i] in root.patches: HorizontalLayout {
                        height: 24px;
                        padding-left: 6px;
                        spacing: 6px;
                        CheckBox {
                            width: 24px;
                            checked: p.checked;
                            toggled => { root.patch-toggled(i, self.checked); }
                        }
                        Text {
                            text: p.path;
                            vertical-alignment: center;
                            overflow: elide;
                            TouchArea { double-clicked => { root.patch-activated(i); } }
                        }
                    }
                }
            }
            if root.delivery-note != "": Text {
                text: root.delivery-note;
                wrap: word-wrap;
                color: Palette.foreground.with-alpha(0.7);
            }
            NoticeBar { text: root.notice-text; error: true; }
            HorizontalBox {
                padding: 0;
                alignment: end;
                Button { text: "Send"; primary: true; clicked => { root.send(); } }
                Button { text: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}

// IDD_COMMITISONREFS: caption "References commit is on".
export component CommitIsOnRefsDialog inherits KoopaWindow {
    in property <string> dialog-title: "References commit is on";
    in-out property <string> commit;
    in property <string> subject;
    in property <[string]> refs;
    in property <string> empty-text;
    in-out property <string> filter;
    in-out property <int> current-row: -1;
    pure callback menu-for(int) -> [MenuBlock];
    callback menu-chosen(int, int);
    callback commit-entered();
    callback filter-changed();
    callback show-log();
    callback ref-activated(int);
    // F5: reload the refs.
    callback refresh();
    // Ctrl+C / Ctrl+Insert in the ref list.
    callback copy-selected();
    // Escape closes the dialog. It has no default button, so Enter outside the
    // commit edit does nothing.
    callback cancel();
    title: root.dialog-title;
    preferred-width: 560px;
    preferred-height: 420px;
    min-width: 420px;
    function select-row(i: int) {
        if (i >= 0 && i < root.refs.length) {
            root.current-row = i;
        }
    }
    // The commit edit has the focus initially (CommitIsOnRefsDlg.cpp:137).
    forward-focus: commit-edit;
    keys := DialogKeys {
        // Escape in a non-empty filter clears it first.
        cancel => {
            if (filter-edit.has-focus && root.filter != "") {
                root.filter = "";
                root.filter-changed();
            } else {
                root.cancel();
            }
        }
        KeyBinding {
            keys: @keys(F5);
            activated => { root.refresh(); }
        }
        VerticalBox {
            HorizontalLayout {
                spacing: 8px;
                commit-edit := LineEdit {
                    text <=> root.commit;
                    placeholder-text: "Commit";
                    accepted => { root.commit-entered(); }
                }
                Button { text: "Show log"; enabled: root.subject != ""; clicked => { root.show-log(); } }
            }
            Text { text: root.subject; overflow: elide; }
            // The ref list: a tab stop; arrows move the selection, Ctrl+C copies.
            // It is single-selection, so upstream's Ctrl+A (select all) has no equivalent.
            list-keys := FocusScope {
                vertical-stretch: 1;
                key-pressed(e) => {
                    if ((e.modifiers.control || e.modifiers.meta) && !e.modifiers.alt
                            && (e.text.to-lowercase() == "c" || e.text == Key.Insert)) {
                        if (root.current-row >= 0) { root.copy-selected(); }
                        return accept;
                    }
                    if (e.modifiers.control || e.modifiers.alt || e.modifiers.meta) { return reject; }
                    if (e.text == Key.UpArrow) { root.select-row(max(0, root.current-row - 1)); return accept; }
                    if (e.text == Key.DownArrow) { root.select-row(min(root.refs.length - 1, root.current-row + 1)); return accept; }
                    if (e.text == Key.Home) { root.select-row(0); return accept; }
                    if (e.text == Key.End) { root.select-row(root.refs.length - 1); return accept; }
                    reject
                }
                Rectangle {
                    border-width: 1px;
                    border-color: list-keys.has-focus ? Palette.accent-background : Palette.border;
                    if root.refs.length == 0: Text {
                        text: root.empty-text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: Palette.foreground.with-alpha(0.6);
                    }
                    ListView {
                        for r[i] in root.refs: Rectangle {
                            height: 22px;
                            background: i == root.current-row ? Palette.selection-background : transparent;
                            DynMenuArea {
                                blocks() => { return root.menu-for(i); }
                                chosen(id) => { root.menu-chosen(i, id); }
                                TouchArea {
                                    clicked => {
                                        list-keys.focus();
                                        root.current-row = i;
                                    }
                                    double-clicked => { root.current-row = i; root.ref-activated(i); }
                                    pointer-event(e) => {
                                        if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                            root.current-row = i;
                                            parent.show({ x: self.mouse-x, y: self.mouse-y });
                                        }
                                    }
                                }
                            }
                            Text {
                                x: 6px;
                                text: r;
                                vertical-alignment: center;
                                height: parent.height;
                                color: i == root.current-row ? Palette.selection-foreground : Palette.foreground;
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Filter: "; vertical-alignment: center; }
                filter-edit := LineEdit {
                    text <=> root.filter;
                    edited => { root.filter-changed(); }
                }
            }
        }
    }
}

// The First Start Wizard (Start, Language, Git, User, Authentication pages).
export component FirstStartDialog inherits KoopaWindow {
    in property <string> dialog-title: "First Start Wizard - KoopaGit";
    in-out property <int> page;
    in property <string> git-version;
    in-out property <string> git-path;
    in-out property <string> extra-path;
    in-out property <string> user-name;
    in-out property <string> user-email;
    in-out property <bool> dont-save-user;
    in property <[string]> ssh-clients;
    in-out property <int> ssh-index;
    in property <[string]> credential-helpers;
    in-out property <int> credential-index;
    in-out property <bool> dont-save-auth;
    in property <string> notice-text;
    callback browse-git();
    callback check-git();
    callback back();
    callback next();
    callback finish();
    callback cancel();
    title: root.dialog-title;
    preferred-width: 600px;
    preferred-height: 420px;
    min-width: 520px;
    // The wizard's default button: Next >, or Finish on the last page.
    function default-button() {
        if (root.page < 4) {
            root.next();
        } else {
            root.finish();
        }
    }
    forward-focus: keys;
    keys := DialogKeys {
        ok => { root.default-button(); }
        cancel => { root.cancel(); }
        // Wizard buttons "< &Back" / "&Next >" (system captions, inferred) and the page
        // captions C&heck now (Git) and &Don't store these settings now (User,
        // Authentication). The label access keys (&Language:, &Git.exe Path:, &Extra
        // PATH:, &Name:, &Email:, &Credential helper:) would focus controls on
        // conditional pages, which cannot be reached by id; Alt+N is Next.
        access-key(k) => {
            if (k == "b") { if (root.page > 0) { root.back(); } return true; }
            if (k == "n") { if (root.page < 4) { root.next(); } return true; }
            if (k == "h" && root.page == 2) { root.check-git(); return true; }
            if (k == "d" && root.page == 3) { root.dont-save-user = !root.dont-save-user; return true; }
            if (k == "d" && root.page == 4) { root.dont-save-auth = !root.dont-save-auth; return true; }
            false
        }
        VerticalBox {
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 8px;
                if root.page == 0: Text {
                    wrap: word-wrap;
                    text: "Welcome to KoopaGit, a clone of TortoiseGit.\n\nThis wizard helps you to configure the most important settings: the user interface language, the git executable, your name and email for commits, and authentication.\n\nYou can rerun it at any time from Settings > General.";
                }
                if root.page == 1: VerticalLayout {
                    spacing: 8px;
                    Text { wrap: word-wrap; text: "Select the language of the user interface. Only English is available in koopagit."; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Language:"; width: 120px; vertical-alignment: center; }
                        ComboBox { model: ["English (United States)"]; }
                    }
                }
                if root.page == 2: VerticalLayout {
                    spacing: 8px;
                    Text { wrap: word-wrap; text: "koopagit requires a git executable for its operations. It tries to automatically detect a working git, but if that doesn't work or you want to use a different one please specify the path manually!"; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Git.exe Path:"; width: 120px; vertical-alignment: center; }
                        LineEdit {
                            text <=> root.git-path;
                            placeholder-text: "(autodetect from PATH)";
                            accepted => { root.default-button(); }
                        }
                        Button { text: "..."; clicked => { root.browse-git(); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Extra PATH:"; width: 120px; vertical-alignment: center; }
                        LineEdit {
                            text <=> root.extra-path;
                            accepted => { root.default-button(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.git-version; vertical-alignment: center; horizontal-stretch: 1; }
                        Button { text: "Check now"; clicked => { root.check-git(); } }
                    }
                }
                if root.page == 3: VerticalLayout {
                    spacing: 8px;
                    Text { wrap: word-wrap; text: "Git requires that you set up a user name and email address. Both are used as meta data for your commits (not for authentication)."; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Name:"; width: 120px; vertical-alignment: center; }
                        LineEdit {
                            text <=> root.user-name;
                            accepted => { root.default-button(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Email:"; width: 120px; vertical-alignment: center; }
                        LineEdit {
                            text <=> root.user-email;
                            accepted => { root.default-button(); }
                        }
                    }
                    Text { wrap: word-wrap; text: "These settings will be stored to your global git configuration (~/.gitconfig) and will be used for all your git repositories as a default."; }
                    CheckBox { text: "Don't store these settings now."; checked <=> root.dont-save-user; }
                }
                if root.page == 4: VerticalLayout {
                    spacing: 8px;
                    GroupBox {
                        title: "SSH (URLs look like \"git@example.com\")";
                        VerticalLayout {
                            spacing: 6px;
                            Text { wrap: word-wrap; text: "Git uses the SSH client of your system. Choose which one to use (stored as core.sshCommand)."; }
                            ComboBox { model: root.ssh-clients; current-index <=> root.ssh-index; }
                        }
                    }
                    GroupBox {
                        title: "HTTP (URLs start with \"http://\" or \"https://\")";
                        VerticalLayout {
                            spacing: 6px;
                            Text { wrap: word-wrap; text: "By default Git does not save/cache credentials. However, you can configure a credential helper (recommended)."; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Credential helper:"; width: 140px; vertical-alignment: center; }
                                ComboBox { model: root.credential-helpers; current-index <=> root.credential-index; }
                            }
                        }
                    }
                    CheckBox { text: "Don't store these settings now."; checked <=> root.dont-save-auth; }
                }
            }
            NoticeBar { text: root.notice-text; error: true; }
            HorizontalBox {
                padding: 0;
                alignment: end;
                Button { text: "< Back"; enabled: root.page > 0; clicked => { root.back(); } }
                if root.page < 4: Button { text: "Next >"; primary: true; clicked => { root.next(); } }
                if root.page == 4: Button { text: "Finish"; primary: true; clicked => { root.finish(); } }
                Button { text: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}
